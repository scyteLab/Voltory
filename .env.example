# Copy this file to .env and fill in real values from your Supabase
# project (Project Settings → API). .env is gitignored — never commit it.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed locally to run scripts/seed-supabase.mjs — this key
# bypasses Row Level Security, so it must never ship to the browser
# or get committed. Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Paystack (Session 35a) ----
# Public key from https://dashboard.paystack.com/#/settings/developers
# Use pk_test_... during development, pk_live_... in production.
# If unset, checkout offers Pay on Delivery only.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

# NETLIFY FUNCTION env vars for paystack-verify / paystack-webhook.
# Set these in the Netlify dashboard. They must NEVER be prefixed
# with VITE_ (that would ship them to the browser).
#   PAYSTACK_SECRET_KEY       = sk_test_... (sk_live_... in production)
#   SUPABASE_URL              = https://YOUR-PROJECT-REF.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY = (same service-role key as above)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# ---- Resend / Email ----
# All email is sent by Netlify Functions; nothing email-related is
# set with a VITE_ prefix any more. Set these in the Netlify dashboard
# (Site settings → Environment variables), not in your local .env:
#
#   RESEND_API_KEY     = re_xxxxxxxxxxxx (from resend.com/api-keys)
#   RESEND_FROM_EMAIL  = "NAVEN <noreply@mynaven.com>"  (verified sender)
#   NOTIFY_EMAILS      = business@mynaven.com,support@mynaven.com
#                        (team inbox for new orders + every form)
#   WEBHOOK_SECRET     = long random string; Supabase Database Webhooks
#                        send it in the x-webhook-secret header
#   SITE_URL           = https://mynaven.com  (optional; "Open in admin" links)
#
# send-email (order emails) and notify-new-submission (form emails)
# read these at runtime. SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# above are also needed by send-email to load the order.
